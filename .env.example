# ================================================================
# 1. BACKEND VARIABLES (Add these to RAILWAY Environment Variables)
# ================================================================
# Google Gemini API Key (required for AI matching & reports)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: PostgreSQL Database URL (Supabase or Railway Postgres plugin)
# Leave empty or comment out to default to persistent SQLite engine
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Allowed Frontend Origins for CORS (comma-separated or leave unset for all)
ALLOWED_ORIGINS=https://your-assetflow.vercel.app,http://localhost:5173

# Optional: Base app url
APP_URL="http://localhost:3001"


# ================================================================
# 2. FRONTEND VARIABLES (Add these to VERCEL Project Environment Variables)
# ================================================================
# The public URL of your deployed Railway backend (NO trailing slash)
VITE_API_BASE_URL=https://your-railway-backend.up.railway.app

# Firebase Web Client Configuration (for Authentication)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

